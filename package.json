{
  "name": "arcane-desk-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "foundry-modules/*"
  ],
  "scripts": {
    "build:sdk": "npm run build --workspace @arcanedesk/foundry-sdk",
    "build:webmcp": "npm run build --workspace @arcanedesk/foundry-webmcp",
    "build": "npm run build:sdk && npm run build --workspace @arcanedesk/fvtt-cli && npm run build:webmcp",
    "pretest": "npm run build:sdk",
    "test": "npm test --workspaces --if-present",
    "pretypecheck": "npm run build:sdk",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pack:check": "node scripts/smoke-packed-packages.mjs",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "verify:repo": "node scripts/verify-repository.mjs",
    "verify": "npm run verify:repo && npm run docs:check && npm run typecheck && npm test && npm run build && npm run pack:check"
  }
}
