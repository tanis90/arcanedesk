# Dependencies and package manager output
node_modules/
# Vendored runtime dependencies shipped inside the self-contained skills bundle
!apps/desktop/skills/prep/arcane-fvtt-mods/scripts/node_modules/
!apps/desktop/skills/prep/arcane-fvtt-mods/scripts/node_modules/**
*.tgz
npm-debug.log*

# Build and test output
dist/
# 本地签名副本（sign-windows.mjs 输出，publish-release --signed-dir 输入）
dist-signed/
build/
# electron-builder signing resources are source, not output
!apps/desktop/build/
!apps/desktop/build/**
coverage/
generated/
artifacts/
*.log

# Local runtime state and secrets
.env
.env.*
!.env.example
*.local
key
*.key
*.pem
.local-secrets/
runtime/
# apps/desktop/runtime/ 是随包分发的 mt-agent-runtime.js 源文件目录(非本地运行状态):
# bundled 默认 runtime 要进 git,逐级解除上面的 runtime/ 忽略。
!apps/desktop/runtime/
!apps/desktop/runtime/**

# Editor and OS state
.idea/
.vscode/
.zcodeignore
.DS_Store
Thumbs.db
*.swp

# Temporary files
.tmp/
tmp/
temp/
tmp-e2e/
tmp-design/
