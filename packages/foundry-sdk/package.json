{
  "name": "@arcanedesk/foundry-sdk",
  "version": "0.1.0",
  "description": "Transport-neutral Foundry VTT runtime contracts and client for Arcane Desk",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./runtime-helpers": {
      "types": "./dist/runtime-helpers.d.ts",
      "import": "./dist/runtime-helpers.js",
      "default": "./dist/runtime-helpers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arcanedesk/arcane-desk.git",
    "directory": "packages/foundry-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
